# Opens the navigation tables fix on MrAntares/roBrowserLegacy, then the
# matching patch change on Flux159/ragnarokoffline.app, which links to it.
set mb (mktemp); set fb (mktemp)
echo '' | base64 -d > $mb
echo '' | base64 -d > $fb
set url (gh pr create --repo MrAntares/roBrowserLegacy --base master \
  --head akreao:claude/project-thread-nzefbb \
  --title "fix(Navigation): keep the navigation tables' length so routes between maps work" \
  --body-file $mb)
or begin; echo "MrAntares PR failed"; rm $mb $fb; exit 1; end
echo $url
sed -i "s|MRANTARES_PR|$url|" $fb
gh pr create --repo Flux159/ragnarokoffline.app --base main \
  --head akreao:claude/project-thread-nzefbb \
  --title "Let the navigation patch run on a client that already has its fixes" \
  --body-file $fb
rm $mb $fb
